# Python virtual environment (rebuild with: python -m venv venv && pip install -r requirements.txt)
venv/
**/__pycache__/
*.pyc

# Trained RL model checkpoints (large binaries, hundreds of snapshots per training run)
src/checkpoints/

# Raw per-run telemetry/sensor data (many small files per run; keep summary CSVs only)
src/runs/*/run_*/
previous_src_tests/test3_rare_hazard_scenario/runs/*/run_*/

# Raw per-tick physical-limits traces/manifests (Week 3 physics harness) --
# keep code, compact summaries, and findings in worklogs/PRs, not raw traces.
src/runs/physics/

# Raw per-tick trajectory traces + rendered plots (Week 3 trajectory
# visualization tooling) -- same reasoning, keep the tool and findings, not
# raw run data/images.
src/runs/trajectory_viz/

# Raw per-run traces/manifests from the steering-plus-braking baseline
# (test26) -- same reasoning; findings go in worklogs/PRs/MASTER summary.
src/runs/steer_brake_baseline/

# Raw per-episode traces/steps/metrics from encounter-protocol RL evaluation
# (eval_policy_encounters.py) -- same reasoning.
src/runs/rl_encounter_eval/

# Raw per-run traces/metrics from the fixed-profile matched-sweep re-score
# (test27) -- same reasoning.
src/runs/fixed_profile_rescore/

# Raw camera frame captures
previous_src_tests/test0_ego_camera/out/

# Throwaway diagnostic scripts/dumps for investigating a live finding --
# not part of the numbered test suite, not a tracked research artifact.
src/_scratch/

# AI-agent planning prompts/scratch — not part of the tracked research record
plans/

# Per-branch worklog CONTENT stays local/private (raw in-progress research notes).
# The worklog SYSTEM itself (README, template, hook) stays tracked — see worklog/README.md.
worklog/*
!worklog/README.md
!worklog/_TEMPLATE.md

# Editor-local settings
.vscode/

# OS artifacts
Thumbs.db
.DS_Store
